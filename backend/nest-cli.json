{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ams-apis/src",
  "monorepo": true,
  "root": "apps/ams-apis",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/ams-apis/tsconfig.app.json"
  },
  "projects": {
    "ams-apis": {
      "type": "application",
      "root": "apps/ams-apis",
      "entryFile": "main",
      "sourceRoot": "apps/ams-apis/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ams-apis/tsconfig.app.json"
      }
    },
    "file-services": {
      "type": "application",
      "root": "apps/file-services",
