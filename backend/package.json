{
  "name": "ams-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AMS back end: NestJS monorepo (Prisma, PostgreSQL, Redis)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build ams-apis",
    "build:all": "nest build ams-apis && nest build file-services && nest build background-worker && nest build scheduler-job && nest build control-panel",
    "start": "nest start ams-apis",
    "start:dev": "nest start ams-apis --watch",
    "start:prod": "node dist/apps/ams-apis/apps/ams-apis/src/main.js",
    "lint": "eslint \"{apps,libs,config,tests}/**/*.ts\" && node scripts/check-headers.js",
    "lint:headers": "node scripts/check-headers.js",
    "format": "prettier --write \"{apps,libs,config,scripts}/**/*.{ts,js}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --testRegex \".e2e-spec.ts$\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/supertest": "^6.0.2",
    "eslint": "^9",
    "jest": "^29.7.0",
    "prettier": "^3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@config$": "<rootDir>/config",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@libs/([^/]+)$": "<rootDir>/libs/$1/src",
      "^@libs/([^/]+)/(.*)$": "<rootDir>/libs/$1/src/$2",
      "^@app/([^/]+)/(.*)$": "<rootDir>/apps/$1/src/$2"
    }
  }
}
