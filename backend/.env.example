# AMS back end - environment variables (Project Foundation v0.1, section 7). Never commit real values.
# App
APP_NAME=ams
APP_ENV=dev
APP_PORT=3000
# Database (Prisma)
# Local compose database. If port 5432 is taken on your machine, set POSTGRES_PORT=5433 and use it here.
DATABASE_URL=postgresql://ams:ams@localhost:5432/ams
POSTGRES_PORT=5432
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PREFIX=ams
# Tokens
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Sign-in
AUTH_LOCAL_ENABLED=true
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30
SSO_METADATA_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# E-mail (SES or SMTP)
MAIL_TRANSPORT=smtp
MAIL_FROM=ams@example.invalid
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
AWS_SES_REGION=ap-south-1
# Files
S3_BUCKET=
S3_REGION=ap-south-1
# URLs
WEB_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
# Seed
SEED_ADMIN_EMPLOYEE_CODE=10001
SEED_ADMIN_EMAIL=admin@example.invalid
AUTH_PORT=3200
